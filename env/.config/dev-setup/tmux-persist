#!/usr/bin/env bash
# tmux-persist — save, restore, list, and clear tmux sessions

SESSIONS_DIR="$HOME/.tmux-sessions"
SHELL_NAMES="bash|zsh|sh|fish|dash|ksh|tcsh|csh"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

mkdir -p "$SESSIONS_DIR"

# print usage
usage() {
  echo -e "${BOLD}tmux-persist${RESET} — persist and restore tmux sessions\n"
  echo -e "  ${CYAN}tmux-persist save${RESET}              save all sessions"
  echo -e "  ${CYAN}tmux-persist save -t NAME${RESET}      save one session"
  echo -e "  ${CYAN}tmux-persist restore -t NAME${RESET}   restore a session"
  echo -e "  ${CYAN}tmux-persist list${RESET}              list saved sessions"
  echo -e "  ${CYAN}tmux-persist clear${RESET}             delete all saved sessions"
  echo -e "  ${CYAN}tmux-persist clear -t NAME${RESET}     delete one saved session"
}

# get the active command running in a pane (empty if idle shell)
get_pane_command() {
  local session="$1" win_idx="$2"

  # get the shell PID of the pane
  local pane_pid
  pane_pid=$(tmux display-message -t "${session}:${win_idx}" -p '#{pane_pid}' 2>/dev/null)
  [[ -z "$pane_pid" ]] && echo "" && return

  # look for a child process spawned by the shell
  local child_pid
  child_pid=$(pgrep -P "$pane_pid" 2>/dev/null | head -1)
  [[ -z "$child_pid" ]] && echo "" && return

  # get the full command with all args
  local full_cmd
  full_cmd=$(ps -p "$child_pid" -o args= 2>/dev/null | sed 's/^ *//')
  [[ -z "$full_cmd" ]] && echo "" && return

  # treat nested shells as idle
  local cmd_name
  cmd_name=$(basename "$(awk '{print $1}' <<< "$full_cmd")")
  if echo "$cmd_name" | grep -qE "^($SHELL_NAMES)$"; then
    echo "" && return
  fi

  echo "$full_cmd"
}

# save a single session to its file
save_session() {
  local session="$1"

  if ! tmux has-session -t "$session" 2>/dev/null; then
    echo -e "${RED}error:${RESET} session '${session}' not found"
    return 1
  fi

  local file="$SESSIONS_DIR/${session}.session"

  # write header with timestamp
  printf "# session: %s\n" "$session"  > "$file"
  printf "# saved: %s\n"   "$(date '+%Y-%m-%d %H:%M:%S')" >> "$file"

  # save each window: index, name, working dir, and running command
  while IFS=: read -r idx name path; do
    local cmd
    cmd=$(get_pane_command "$session" "$idx")
    # use | as delimiter so cmds with colons (e.g. ssh tunnels) are preserved
    printf "window|%s|%s|%s|%s\n" "$idx" "$name" "$path" "$cmd" >> "$file"
  done < <(tmux list-windows -t "$session" -F "#{window_index}:#{window_name}:#{pane_current_path}")

  local count
  count=$(grep -c "^window|" "$file")
  echo -e "${RESET} saved ${BOLD}${session}${RESET} (${count} windows) → ${CYAN}${file/$HOME/\~}${RESET}"
}

# save all sessions or a specific one
cmd_save() {
  if [[ "$1" == "-t" && -n "$2" ]]; then
    save_session "$2"
    return
  fi

  # get all running sessions
  local sessions
  sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null)
  if [[ -z "$sessions" ]]; then
    echo -e "${YELLOW}no active tmux sessions${RESET}"
    return 1
  fi

  while IFS= read -r s; do
    save_session "$s"
  done <<< "$sessions"
}

# restore a session from its saved file
cmd_restore() {
  if [[ "$1" != "-t" || -z "$2" ]]; then
    echo -e "${RED}usage:${RESET} tmux-persist restore -t <session>\n"
    cmd_list
    return 1
  fi

  local session="$2"
  local file="$SESSIONS_DIR/${session}.session"

  if [[ ! -f "$file" ]]; then
    echo -e "${RED}error:${RESET} no saved session '${session}'\n"
    cmd_list
    return 1
  fi

  # attach if session is already alive
  if tmux has-session -t "$session" 2>/dev/null; then
    echo -e "${YELLOW}session '${session}' already running — attaching${RESET}"
    tmux attach-session -t "$session"
    return 0
  fi

  local first=true count=0

  while IFS= read -r line; do
    # skip comments and blank lines
    [[ "$line" =~ ^# || -z "$line" ]] && continue

    # parse window|idx|name|path|cmd  (cmd may contain colons, e.g. ssh tunnels)
    IFS='|' read -r _ idx name path cmd <<< "$line"

    # fall back to home dir if path no longer exists
    [[ -d "$path" ]] || path="$HOME"

    if $first; then
      # create the session with the first window
      tmux new-session -d -s "$session" -n "$name" -c "$path"
      first=false
    else
      # append subsequent windows
      tmux new-window -t "$session" -n "$name" -c "$path"
    fi

    # replay the saved command (node servers, ssh tunnels, etc.)
    if [[ -n "$cmd" ]]; then
      tmux send-keys -t "${session}:${idx}" "$cmd" Enter
    fi

    ((count++))
  done < "$file"

  echo -e "${RESET} restored ${BOLD}${session}${RESET} (${count} windows)"
  tmux attach-session -t "$session"
}

# list all saved session files
cmd_list() {
  local files=("$SESSIONS_DIR"/*.session)

  if [[ ! -e "${files[0]}" ]]; then
    echo -e "${YELLOW}no saved sessions${RESET}"
    return 0
  fi

  echo -e "${BOLD}saved sessions:${RESET}"
  for f in "${files[@]}"; do
    local name saved count status
    name=$(basename "$f" .session)
    saved=$(grep "^# saved:" "$f" | cut -d' ' -f3-)
    count=$(grep -c "^window|" "$f")

    # check if session is currently running
    if tmux has-session -t "$name" 2>/dev/null; then
      status="${GREEN}running${RESET}"
    else
      status="${RED}stopped${RESET}"
    fi

    echo -e "  ${CYAN}${name}${RESET}  ${count} window(s)  saved ${saved}  [${status}]"
  done
}

# delete saved session file(s)
cmd_clear() {
  if [[ "$1" == "-t" && -n "$2" ]]; then
    local file="$SESSIONS_DIR/${2}.session"
    if [[ ! -f "$file" ]]; then
      echo -e "${RED}error:${RESET} no saved session '${2}'"
      return 1
    fi
    rm "$file"
    echo -e "${RESET}cleared '${2}'"
    return
  fi

  local files=("$SESSIONS_DIR"/*.session)
  if [[ ! -e "${files[0]}" ]]; then
    echo -e "${YELLOW}nothing to clear${RESET}"
    return 0
  fi

  rm "${files[@]}"
  echo -e "${RESET}cleared all saved sessions"
}

# dispatch to subcommand
case "$1" in
  save)    shift; cmd_save    "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  list)          cmd_list          ;;
  clear)   shift; cmd_clear   "$@" ;;
  *)             usage             ;;
esac
